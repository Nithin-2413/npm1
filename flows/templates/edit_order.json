{
  "id": "edit_order",
  "name": "Edit Existing Order",
  "category": "management",
  "description": "Edit an existing order to change quantity or location",
  "estimated_duration_seconds": 60,
  "required_params": ["order_id"],
  "optional_params": ["new_quantity", "new_location"],
  "defaults": {},
  "steps": [
    {
      "step": 1,
      "description": "Navigate to Orders page",
      "action": "click_button",
      "locator_strategies": [
        {"priority": 1, "type": "text", "value": "Orders"}
      ],
      "human_reasoning": "Go to orders list"
    },
    {
      "step": 2,
      "description": "Search for order",
      "action": "fill_field",
      "locator_strategies": [
        {"priority": 1, "type": "placeholder", "value": "Search orders..."}
      ],
      "value": "{{order_id}}",
      "human_reasoning": "Find the order to edit"
    },
    {
      "step": 3,
      "description": "Click on order",
      "action": "click_button",
      "locator_strategies": [
        {"priority": 1, "type": "text", "value": "{{order_id}}"}
      ],
      "human_reasoning": "Open order details"
    },
    {
      "step": 4,
      "description": "Click Edit button",
      "action": "click_button",
      "locator_strategies": [
        {"priority": 1, "type": "role", "name": "Edit Order"}
      ],
      "human_reasoning": "Enter edit mode"
    },
    {
      "step": 5,
      "description": "Update quantity if provided",
      "action": "fill_field",
      "locator_strategies": [
        {"priority": 1, "type": "label", "value": "Quantity"}
      ],
      "value": "{{new_quantity}}",
      "conditional": "new_quantity",
      "human_reasoning": "Change quantity if specified"
    },
    {
      "step": 6,
      "description": "Click Save Changes",
      "action": "click_button",
      "locator_strategies": [
        {"priority": 1, "type": "role", "name": "Save Changes"}
      ],
      "human_reasoning": "Save the edits"
    },
    {
      "step": 7,
      "description": "Wait for success message",
      "action": "wait_for_element",
      "locator_strategies": [
        {"priority": 1, "type": "text", "value": "Order updated successfully"}
      ],
      "max_wait_ms": 5000,
      "human_reasoning": "Confirm edit completed"
    },
    {
      "step": 8,
      "description": "Validate updated order in database",
      "action": "db_validate",
      "wait_before_ms": 3000,
      "order_id_from_context": "order_id",
      "human_reasoning": "Verify database reflects changes"
    }
  ]
}